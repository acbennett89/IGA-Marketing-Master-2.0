# IGA Marketing Master 2.0 — git ignore rules.
# Windows + Python standard exclusions plus project-specific runtime artifacts.

# --- Python bytecode + caches ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/

# --- Build / packaging artifacts ---
*.egg-info/
dist/
build/

# --- Test / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Windows / macOS noise ---
Thumbs.db
.DS_Store
desktop.ini

# --- Editor / IDE configs ---
.vscode/
.idea/

# --- Claude Code / agent tooling state (per-project, not portable) ---
.claude/
.playwright-mcp/

# --- Project runtime state (per PLAN-REVIEW.md, never committed) ---
Working Library/

# --- Test sandbox (per-run state; fixtures are tracked, runtime state is not) ---
testing/sandbox/working_library/
testing/sandbox/logs/

# --- Diagnostic ---
# diagnostic_inputs/: PDFs are gitignored (real or synthetic, may contain PII);
#   the README.md inside is tracked.
# diagnostic_workspace/: runtime state from scripts/diagnose.py runs.
# Example Clients/: real client folders with PDFs that may contain PII.
Testing and Example Library/diagnostic_inputs/*.pdf
Testing and Example Library/diagnostic_workspace/
Testing and Example Library/Example Clients/

# --- Backups, temp, debug ---
*.bak
*.tmp
debug/

# --- Loose inspection artifacts at repo root (CDP screenshots, snapshot dumps) ---
/*.png
/*-snapshot.md
/snapshot-*.md

# --- Secrets ---
.env
secrets.dat
*.key
